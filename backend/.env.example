# --- Django ---------------------------------------------------------------
# Django secret key (signs sessions and tokens). Change it in production.
# Required with DEBUG=false (at least 50 random characters). Generate one:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
# true = detailed error pages: development only, never in production.
DEBUG=false
# Hosts the API can be reached at (comma separated). * = any: development only.
ALLOWED_HOSTS=dns.example.lan

# --- Database -------------------------------------------------------------
# If missing or commented out, sqlite (db.sqlite3) is used. Otherwise:
# sqlite | postgres://user:pass@host:5432/dns | mysql://user:pass@host:3306/dns
DATABASE_URL=postgres://dns:secret@db.example.lan:5432/dns
# Connections to the database stay open and are reused (a pool: one per API thread and per DNS worker thread).
#DB_CONN_MAX_AGE=600   # seconds a connection lives before it is replaced; 0 = open and close for every request/query
#DNS_LOG_FLUSH=1       # the query log is saved in batches every second, off the answering path (0 = save each row before answering).
#                       A sudden crash can lose the last second of log rows.
#DNS_LOG_QUEUE=50000   # rows that may wait for the next batch; if the database cannot keep up, newer ones are dropped
#DNS_WORKERS=16        # DNS daemon threads per protocol (UDP, TCP) = database connections it keeps open. The database's max_connections
#                       must cover about DNS_WORKERS * 2 + the API threads (8) + a few for management commands.

# --- DNS ------------------------------------------------------------------
# Resolver(s) that names outside the internal zones are forwarded to. Several, comma separated, are tried in order:
# if the first does not answer, the next one is used (e.g. UPSTREAM_DNS=192.168.1.254,1.1.1.1,9.9.9.9).
UPSTREAM_DNS=1.1.1.1
#DNS_DATA_CHECK=1         # seconds between looks at the change counter: zones, records and blocklist stay in memory (and in Redis, if REDIS_URL is set; then it is checked on every query) until it moves
#DNS_DATA_TTL=300         # safety: reload anyway after this many seconds (covers changes made behind the app's back, e.g. raw SQL)
#DNS_UPSTREAM_TIMEOUT=2   # seconds to wait for one upstream before trying the next
#DNS_UPSTREAM_DOWN=30     # seconds an upstream that failed is skipped (so a dead one does not slow every query)
#DNS_STALE_TTL=86400      # when every upstream is down, answers that expired up to this many seconds ago are still served (needs DNS_CACHE); 0 = never
# Zone the GUI opens by default (name, e.g. corp.lan). Empty or unknown = you choose.
DEFAULT_ZONE=
# Seconds a sign-in lasts at most (API token and Django admin session), then the user signs in again. Default 7200 (2 hours).
#SESSION_MAX_AGE=7200
# Days of query history kept (log and statistics counters). On MySQL/MariaDB and PostgreSQL, `manage.py partition_querylog` (once) makes the purge instant.
QUERY_LOG_DAYS=7

# --- Time zone --------------------------------------------------------------
# Times are stored in UTC; the GUI shows them in the browser's time zone. This is the zone the Django admin shows them in (e.g. Europe/Rome).
# MySQL/MariaDB: its admin date filter needs the zone tables once: mysql_tzinfo_to_sql /usr/share/zoneinfo | mysql -u root mysql
#TIME_ZONE=UTC

# --- Login ----------------------------------------------------------------
# Encrypted sign-in: off | optional | required. The server makes its keys by itself at every start.
# required = plain sign-in is refused.
LOGIN_ENCRYPTION=off

# --- GeoIP ----------------------------------------------------------------
# Local GeoIP (optional, MaxMind .mmdb format): city-level location, fully offline.
# Several files separated by commas (DB-IP: one for IPv4 and one for IPv6).
GEOIP_CITY_DB=
# Network database (ASN and organisation).
GEOIP_ASN_DB=
# true = for what the local databases do not know (e.g. the network) ask Team Cymru over DNS; false = fully offline.
GEOIP_ONLINE_FALLBACK=true
# IP -> ASN index for the networks the ASN database lacks, built by `manage.py import_asn` (run it nightly from cron). Empty = off.
#ASN_INDEX=/path/backend/geoip-data/asn-index.bin
#ASN_IMPORT_URL=https://github.com/ipverse/as-ip-blocks/releases/latest/download/as-ip-blocks.tar.gz

# --- Suspicious queries ---------------------------------------------------
# Suspicious queries (tunnelling, DGA, ANY/AXFR, subdomain scanning): off | log | block
# log = flag them in the query log but forward them; block = answer NXDOMAIN.
# Public blocklists for `manage.py import_blocklist` (comma-separated `name=url`, hosts format or one domain per line; the name labels the entries and the list can be switched off in the GUI). Default: StevenBlack, OISD small, 1Hosts Lite and the HaGeZi lists Ultimate, TIF, Popup Ads, Fake and the native telemetry ones (see settings.py).
#BLOCKLISTS=stevenblack=https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts,oisd=https://small.oisd.nl/domainswild2
SUSPICIOUS_MODE=block
# Main domains that are never checked (comma separated)
SUSPICIOUS_ALLOW=

# Optional thresholds (defaults):
#SUSPICIOUS_MAX_NAME=120          # maximum length of the whole name
#SUSPICIOUS_MAX_LABEL=50          # maximum length of a single label
#SUSPICIOUS_ENTROPY=3.9           # entropy (bits/character) above which a label looks random
#SUSPICIOUS_ENTROPY_MIN_LEN=24    # only check entropy on labels at least this long
#SUSPICIOUS_MAX_UNIQUE=40         # distinct subdomains of the same domain per client...
#SUSPICIOUS_WINDOW=60             # ...within this many seconds

# --- Cache ----------------------------------------------------------------
# Redis for the cache (shared between processes, survives restarts). Empty = in-process memory cache.
REDIS_URL=
#REDIS_POOL_SIZE=20   # connections kept open to Redis and shared by all threads (one pool per process, reused: no reconnect per query)
# The DNS daemon caches upstream answers for their TTL.
DNS_CACHE=true
#DNS_CACHE_MAX_TTL=300   # seconds: maximum for positive answers
#DNS_CACHE_NEG_TTL=60    # seconds: for NXDOMAIN and empty answers
#DNS_AUTHORITATIVE=true # false: a name under an internal zone with no record is forwarded to the upstream (split DNS); true: NXDOMAIN/NODATA
#DNS_DDR=dot:dns.example.lan@192.168.1.23 doh:dns.example.lan/dns-query{?dns}  # RFC 9462: encrypted resolvers announced for _dns.resolver.arpa (dot:host[:port], doh:host[:port]/path{?dns}, optional @ip,ip hints, after the path for doh). Also printed as DHCP / RA options by: manage.py dnr_options. Check them with: manage.py check_ddr. Empty = none
#DNS_DOH=false          # serve DNS over HTTPS at /dns-query (no login: restrict it in nginx to your clients). DoT: deploy/nginx/dns-dot.conf
#DNS_DOH_BACKEND=127.0.0.1:5353  # the DNS daemon (TCP) that DoH queries are passed to
#DNS_LOCAL_REVERSE=true # reverse lookups (PTR) of private addresses that no zone answers get NXDOMAIN here (RFC 6303) and never go upstream
#DNS_PREFETCH=true      # a cached answer that is asked for again when less than DNS_PREFETCH_AT of its TTL is left is renewed in the
#DNS_PREFETCH_AT=0.2    # background, so popular names never wait for the upstream; names nobody asks for again simply expire
#DNS_PREFETCH_WORKERS=4 # threads that ask the upstream for renewals
#DNS_RATE_LIMIT=0       # max queries per client IP per DNS_RATE_WINDOW seconds (0 = unlimited)
#DNS_RATE_WINDOW=1      # window in seconds for DNS_RATE_LIMIT
#DNS_DNSSEC=false       # validate DNSSEC signatures (RRSIG / DNSKEY / DS) on upstream answers and set AD=1
#DNS_UPDATE_ALLOW=      # comma-separated IPs/CIDRs allowed to send RFC 2136 dynamic DNS updates (OPCODE=UPDATE)

# --- Second factor (MFA) -------------------------------------------------
# true = whoever has no second factor yet must set one up at the next sign-in.
MFA_REQUIRED=true
# Name shown in the authenticator app.
MFA_ISSUER=Zones.dns
# Passkeys: the id is the host name you open the GUI at (no port), the origins are the full GUI addresses. https is required, except on localhost.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:4200,http://localhost:8000
# Where /admin/login/ sends people: the admin is opened from the GUI (password + second factor).
GUI_URL=http://localhost:4200/

# --- Behind nginx (deploy/nginx/dns.example.lan) ----------------------------------
# true only if every request goes through the https proxy: the X-Forwarded-Proto header is trusted and cookies become "secure".
BEHIND_PROXY=false
# https addresses the admin receives forms from (comma separated).
CSRF_TRUSTED_ORIGINS=
# HSTS for the subdomains, and eligibility for the browsers' preload list (silences check --deploy W005 and W021).
# Hard to undo: browsers remember it for a year. Turn on only if EVERY subdomain of your domain is served over https only.
# HSTS_PRELOAD also needs HSTS_INCLUDE_SUBDOMAINS=true; for it to count, nginx must send the same header (deploy/nginx).
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
# With BEHIND_PROXY=true: redirect to https, one-year HSTS and "secure" cookies.
# With nginx: GUI_URL=https://dns.example.lan/  and  WEBAUTHN_RP_ID=dns.example.lan  and  WEBAUTHN_ORIGINS=https://dns.example.lan

# --- Email (the app sends none today) -----------------------------------------
EMAIL_HOST=localhost
EMAIL_PORT=25

# ---- DHCPv4 server (manage.py rundhcp, zones/dhcp/v4.py). Off by default. Only ONE DHCP server may answer on a network: turn off the router's first.
#      Needs the right to bind UDP port 67 (INSTALL.md, section "DHCP"). Leases are in the database (Django admin: DHCP leases).
#DHCP=false
#DHCP_SERVER=192.168.1.2          # this server's own address on the network
#DHCP_NETMASK=255.255.255.0
#DHCP_RANGE=192.168.1.100-192.168.1.200   # first-last, inside the network above
#DHCP_ROUTER=192.168.1.1          # the gateway given to clients (empty = none)
#DHCP_DNS=                        # DNS servers given to clients, space separated (empty = DHCP_SERVER: this resolver)
#DHCP_DOMAIN=lan                  # search domain given to clients
#DHCP_LEASE=86400                 # seconds
#DHCP_RESERVATIONS=aa:bb:cc:dd:ee:ff=192.168.1.10 11:22:33:44:55:66=192.168.1.11   # a MAC always gets its address (space separated)
#DHCP_INTERFACE=                  # Linux: answer on this interface only (eth0)
#DHCP_NTP=                        # NTP servers (option 42), space separated
#DHCP_SEARCH=                     # search domains (option 119, RFC 3397), space separated; empty = DHCP_DOMAIN
#DHCP_ROUTES=10.0.0.0/8=192.168.1.5   # static routes (option 121, RFC 3442): net=gateway, space separated; the default route (DHCP_ROUTER) is added
#DHCP_MTU=0                       # option 26, 0 = not sent
#DHCP_BOOT_SERVER=                # PXE / TFTP server (option 66)
#DHCP_BOOT_FILE=                  # boot file name (option 67 and the BOOTP file field)
#DHCP_PROBE=true                  # ping an address before offering it; one that answers stays out of the pool for 10 minutes (RFC 2131 3.1.2). Delays an offer by up to a second
#DHCP_NAMES=true                  # the DNS server answers <client host name>.<DHCP_DOMAIN> from the leases
#DHCP6=false                      # stateless DHCPv6 (no addresses: DNS servers, search list, DNR); needs DHCP_INTERFACE; the router still sends the Router Advertisements
#DHCP6_DNS=                       # IPv6 addresses of the DNS servers given to DHCPv6 clients (space separated)
#DHCP_SUBNETS=            # more networks behind relay agents (giaddr, option 82 echoed): a JSON list, e.g. [{"network":"10.1.0.0/24","range":"10.1.0.10-10.1.0.200","router":"10.1.0.1","dns":"192.168.1.2"}]; keys: network, range, router, dns, domain, lease, ntp, search, routes, mtu, boot_server, boot_file, reservations
#DHCP_UNICAST=false       # Linux, root or CAP_NET_RAW, needs DHCP_INTERFACE: answer a client that has no address yet straight to its hardware address (RFC 2131 4.1) instead of broadcasting
#DHCP6_PREFIX=            # DHCPv6 and Router Advertisements: the on-link prefix, e.g. 2001:db8:1::/64
#DHCP6_POOL=              # DHCPv6 addresses given to clients (IA_NA): first-last inside DHCP6_PREFIX; empty = stateless DHCPv6 (DNS, search list, DNR only)
#DHCP6_PD_POOL=           # prefixes delegated to routers (IA_PD, RFC 3633), e.g. 2001:db8:ff00::/40; empty = none
#DHCP6_PD_LEN=56          # the length of each delegated prefix (longer than the pool prefix, at most 64)
#DHCP6_PD_ROUTES=false    # install/remove kernel IPv6 routes (`ip -6 route`) for delegated IA_PD prefixes
#DHCP6_LEASE=86400        # DHCPv6 valid lifetime in seconds (preferred = 3/4 of it)
#DHCP6_RAPID=false        # DHCPv6 rapid commit: two messages instead of four
#DHCP_RA=false            # send IPv6 Router Advertisements with DNS servers (RDNSS), search list (DNSSL) and DNR; needs DHCP_INTERFACE and CAP_NET_RAW
#DHCP_RA_INTERVAL=600     # seconds between advertisements (4-1800)
#DHCP_RA_ROUTER_LIFETIME=0   # 0: this host is NOT a default router (it only adds DNS information); >0 makes it one
#DHCP_RA_SLAAC=true       # announce DHCP6_PREFIX for stateless autoconfiguration (needs a /64)
#DHCP_DNR=true                    # tell clients that ask about the DNS_DDR resolvers (RFC 9463, option 162)
#DHCP_FAILOVER_SECS=0             # standby failover: ignore DISCOVER until client retry secs >= this value (0 = primary server)
#DHCP6_PREFERENCE=0               # RFC 8415 §21.8 server preference (0 = not sent, 255 = primary immediate selection, <255 = backup)
