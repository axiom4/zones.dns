[Unit]
Description=dns: ad-blocking proxy (runproxy)
# A database or Redis that is not installed is ignored by After=.
After=network-online.target postgresql.service mysql.service mariadb.service redis-server.service
Wants=network-online.target

[Service]
User=dns
Group=dns
WorkingDirectory=/opt/dns/app/backend
ExecStart=/opt/dns/.venv/bin/python manage.py runproxy
Restart=always
RestartSec=3
LimitNOFILE=65536
# A proxy that grows without bound must not take the whole machine's RAM (it froze a Pi: ping answered, SSH, DHCP and DNS did not).
# Past the limit the kernel kills the largest process of the unit, a worker, and the supervisor starts it again; the others go on.
# No swap for it: swapping freezes the machine just the same. On a Raspberry Pi this needs cgroup_enable=memory in /boot/firmware/cmdline.txt.
MemoryMax=3G
MemorySwapMax=0
OOMPolicy=continue
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictNamespaces=true
SystemCallArchitectures=native
UMask=0077
# Only the SQLite files (db, -wal, -shm) and geoip-data need writing; with PostgreSQL/MySQL this can be narrowed to /opt/dns/app/backend/geoip-data.
ReadWritePaths=/opt/dns/app/backend

[Install]
WantedBy=multi-user.target
